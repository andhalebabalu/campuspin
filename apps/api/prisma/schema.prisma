// Prisma schema for the LINK platform. Provider: MySQL protocol (XAMPP's MariaDB is compatible).
//
// Phase 1 only wires up the generator and datasource. The full relational model
// (users, roles, colleges, categories, places, ...) is added in Phase 2 / Phase 4.
// The connection string is NOT stored here: it comes from DATABASE_URL via prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}
