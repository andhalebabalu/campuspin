// Prisma schema for the LINK student ecosystem platform.
//
// Provider: MySQL protocol. Local development runs on XAMPP (MariaDB 10.4); the schema uses only
// features that behave the same on MariaDB 10.4 and MySQL 8.
//
// The connection string is NOT in this file: Prisma 7 rejects `url` inside the schema, so it is
// read from DATABASE_URL by prisma.config.ts (for migrations) and by PrismaService (at runtime).
//
// Conventions
//   - Tables are snake_case plural (@@map); columns keep Prisma's camelCase.
//   - Ids are UUIDv7 stored as CHAR(36): time-ordered, safe to expose, index-friendly.
//   - Every mutable table has createdAt/updatedAt. Foreign keys default to RESTRICT so history is
//     never lost by accident; only owned child rows and pure join rows CASCADE.
//   - ONE central Place table serves every kind of place. Categories (data, not tables) decide
//     what a place is; CategoryAttribute + PlaceAttributeValue hold category-specific details.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// Enums (controlled states only; open-ended sets such as roles and categories are tables)
// ════════════════════════════════════════════════════════════════════════════════════════════

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum CollegeStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum PlaceStatus {
  DRAFT
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BusinessMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum SubmissionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  DUPLICATE
}

enum ContributionType {
  INFO_UPDATE
  PRICE_UPDATE
  HOURS_UPDATE
  PHOTO_ADD
  AMENITY_UPDATE
  CONFIRMATION
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// An enquiry's progress in the business's inbox.
enum LeadStatus {
  NEW
  SEEN
  CONTACTED
  CLOSED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REPORTED
  REMOVED
}

enum ReportReason {
  WRONG_INFO
  SCAM
  PROHIBITED_ITEM
  HARASSMENT
  BUSINESS_CLOSED
  WRONG_LOCATION
  FAKE_LISTING
  WRONG_PRICE
  SPAM
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  PLACE
  REVIEW
  USER
  MARKETPLACE_LISTING
  COMMUNITY_POST
  COMMUNITY_COMMENT
}

enum AttributeDataType {
  BOOLEAN
  INTEGER
  DECIMAL
  TEXT
  ENUM
  MULTI_ENUM
  DATE
}

enum PriceUnit {
  ONE_TIME
  HOUR
  DAY
  WEEK
  MONTH
  SEMESTER
  YEAR
  MEAL
  PAGE
  KG
  TRIP
}

enum CollegePlaceMode {
  AUTO
  PINNED
  EXCLUDED
}

// How a student proved they belong to a college.
enum StudentVerificationMethod {
  COLLEGE_EMAIL
  DOCUMENT
}

// PENDING: code sent / document awaiting review. EXPIRED: lapsed, or staff asked to verify again.
enum StudentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

// Who may see a member's profile details (course, year, activity). Never contact details.
enum ProfileVisibility {
  PUBLIC
  STUDENTS
  PRIVATE
}

// Why a refresh token stopped being usable. ROTATED means "replaced by its successor during a normal
// refresh"; presenting a ROTATED token again is the signal that it was stolen (reuse detection).
enum TokenRevocationReason {
  ROTATED
  LOGOUT
  LOGOUT_ALL
  PASSWORD_RESET
  REUSE_DETECTED
  ADMIN
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// Identity and access
// ════════════════════════════════════════════════════════════════════════════════════════════

model User {
  id                   String     @id @default(uuid(7)) @db.Char(36)
  name                 String     @db.VarChar(120)
  // Profile photo: a square image stored by the uploads endpoint. Null shows initials.
  avatarUrl            String?    @db.VarChar(500)
  // Stored lowercase by the application; the column collation is case-insensitive as well.
  email                String     @unique @db.VarChar(254)
  // Argon2id hash. Plain-text passwords are never stored.
  passwordHash         String     @db.VarChar(255)
  // Null = not verified. The timestamp records when it happened.
  emailVerifiedAt      DateTime?
  // Reserved for phone OTP login later (no schema change needed then).
  phone                String?    @unique @db.VarChar(20)
  phoneVerifiedAt      DateTime?
  status               UserStatus @default(ACTIVE)
  // Student profile: the college they study at (null for business owners and staff).
  collegeId            String?    @db.Char(36)
  course               String?    @db.VarChar(120)
  year                 Int?       @db.TinyInt
  lastLoginAt          DateTime?
  // The last time the account used the web or mobile app; written at most once a minute.
  lastActiveAt         DateTime?
  // The college this member is a VERIFIED student of (null = not verified). Separate from
  // `collegeId` above, which is only the college they chose to browse and never grants anything.
  verifiedCollegeId    String?    @db.Char(36)
  studentVerifiedAt    DateTime?
  // Verification lapses after this; the member verifies again to keep student access.
  studentVerifiedUntil DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  college         College? @relation("StudentCollege", fields: [collegeId], references: [id], onDelete: SetNull)
  verifiedCollege College? @relation("VerifiedStudentCollege", fields: [verifiedCollegeId], references: [id], onDelete: SetNull)

  userRoles                    UserRole[]                   @relation("UserRoleUser")
  assignedRoles                UserRole[]                   @relation("UserRoleAssignedBy")
  createdColleges              College[]                    @relation("CollegeCreatedBy")
  createdPlaces                Place[]                      @relation("PlaceCreatedBy")
  verifiedPlaces               Place[]                      @relation("PlaceVerifiedBy")
  ownedBusinesses              BusinessProfile[]            @relation("BusinessOwner")
  businessMemberships          BusinessMember[]
  requestedClaims              PlaceClaim[]                 @relation("ClaimRequestedBy")
  reviewedClaims               PlaceClaim[]                 @relation("ClaimReviewedBy")
  submissions                  PlaceSubmission[]            @relation("SubmissionSubmittedBy")
  reviewedSubmissions          PlaceSubmission[]            @relation("SubmissionReviewedBy")
  contributions                PlaceContribution[]          @relation("ContributionContributedBy")
  reviewedContributions        PlaceContribution[]          @relation("ContributionReviewedBy")
  reviews                      Review[]                     @relation("ReviewAuthor")
  moderatedReviews             Review[]                     @relation("ReviewModeratedBy")
  reviewReports                ReviewReport[]               @relation("ReviewReportReportedBy")
  handledReviewReports         ReviewReport[]               @relation("ReviewReportReviewedBy")
  savedPlaces                  SavedPlace[]
  leads                        Lead[]                       @relation("LeadSender")
  reports                      Report[]                     @relation("ReportReporter")
  resolvedReports              Report[]                     @relation("ReportResolvedBy")
  notifications                Notification[]
  communityPosts               CommunityPost[]
  communityComments            CommunityComment[]
  communityReactions           CommunityReaction[]
  blocking                     UserBlock[]                  @relation("UserBlockBlocker")
  blockedBy                    UserBlock[]                  @relation("UserBlockBlocked")
  marketplaceListings          MarketplaceListing[]
  buyerConversations           Conversation[]               @relation("ConversationBuyer")
  sellerConversations          Conversation[]               @relation("ConversationSeller")
  conversationMessages         ConversationMessage[]
  auditLogs                    AuditLog[]
  settings                     UserSettings?
  studentVerifications         StudentVerification[]        @relation("StudentVerificationUser")
  reviewedStudentVerifications StudentVerification[]        @relation("StudentVerificationReviewer")
  addedEmailDomains            CollegeEmailDomain[]
  createdPromotions            Promotion[]                  @relation("PromotionCreatedBy")
  creditEntries                ListingCreditEntry[]         @relation("CreditEntryUser")
  creditEntriesMade            ListingCreditEntry[]         @relation("CreditEntryActor")
  updatedSettings              PlatformSetting[]
  dailyVisits                  DailyVisit[]
  createdDailyMenus            DailyMenu[]                  @relation("DailyMenuCreatedBy")
  serviceOrders                ServiceOrder[]               @relation("ServiceOrderStudent")
  invoices                     Invoice[]                    @relation("InvoiceCustomer")
  setCapabilityOverrides       BusinessCapabilityOverride[] @relation("CapabilityOverrideSetBy")
  createdQrCodes               PlaceQrCode[]                @relation("QrCreatedBy")
  serviceRequests              ServiceRequest[]             @relation("ServiceRequestStudent")
  privateDocuments             PrivateDocument[]
  bookings                     Booking[]                    @relation("BookingStudent")
  createdOffers                StudentOffer[]               @relation("OfferCreatedBy")
  offerRedemptions             OfferRedemption[]            @relation("RedemptionStudent")
  verifiedRedemptions          OfferRedemption[]            @relation("RedemptionVerifiedBy")
  assignedSubscriptions        BusinessSubscription[]       @relation("SubscriptionAssignedBy")

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([status])
  @@index([collegeId])
  @@index([verifiedCollegeId])
  @@index([createdAt])
  @@index([lastActiveAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Char(36)
  // Stable machine key (SUPER_ADMIN, ...). Code refers to the key, never to a display name.
  key         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  // System roles are seeded and cannot be deleted from the admin UI.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Char(36)
  // `<resource>.<action>`, e.g. places.manage
  key         String   @unique @db.VarChar(100)
  resource    String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @db.Char(36)
  permissionId String   @db.Char(36)
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @db.Char(36)
  roleId       String   @db.Char(36)
  assignedById String?  @db.Char(36)
  createdAt    DateTime @default(now())

  user       User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ── Authentication tokens (Phase 3) ─────────────────────────────────────────────────────────────
// SECURITY RULE for all three tables below: the raw token is never stored. Only its SHA-256 hash
// (64 hex chars) is, so a database leak cannot be replayed. Rows die with their user (CASCADE).
// Expired rows are harmless but accumulate; `npm run auth:purge-tokens` removes them.

// One row per issued refresh token (a signed JWT). A login starts a "family" (familyId, also the `sid`
// claim of the access token); every rotation adds a row to the same family, so one family is one
// device session. Logging out revokes a family; a password reset revokes all of a user's families.
model RefreshToken {
  id            String                 @id @default(uuid(7)) @db.Char(36)
  userId        String                 @db.Char(36)
  familyId      String                 @db.Char(36)
  tokenHash     String                 @unique @db.Char(64)
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason TokenRevocationReason?
  lastUsedAt    DateTime?
  userAgent     String?                @db.VarChar(255)
  ipAddress     String?                @db.VarChar(45)
  createdAt     DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Single-use link token that proves ownership of the registered email. `usedAt` is set when consumed.
model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// Single-use, short-lived link token for "forgot password". Same shape as the verification token, kept
// as its own table so the two purposes can never be confused or replayed against each other.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// Colleges
// ════════════════════════════════════════════════════════════════════════════════════════════

model College {
  id                  String             @id @default(uuid(7)) @db.Char(36)
  name                String             @db.VarChar(200)
  slug                String             @unique @db.VarChar(200)
  shortName           String?            @db.VarChar(50)
  description         String?            @db.Text
  address             String             @db.VarChar(500)
  city                String             @db.VarChar(100)
  state               String             @db.VarChar(100)
  country             String             @default("India") @db.VarChar(100)
  // Decimal degrees (DOUBLE). Distances to places are calculated from these, never typed in.
  latitude            Float
  longitude           Float
  website             String?            @db.VarChar(500)
  logoUrl             String?            @db.VarChar(1000)
  coverImageUrl       String?            @db.VarChar(1000)
  status              CollegeStatus      @default(DRAFT)
  verificationStatus  VerificationStatus @default(PENDING)
  // Places within this radius are linked to the college automatically (see CollegePlace).
  serviceRadiusMeters Int                @default(5000)
  // Demo/sample rows are flagged so they can never be mistaken for real data or shipped to production.
  isDemo              Boolean            @default(false)
  createdById         String?            @db.Char(36)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  createdBy   User?             @relation("CollegeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  students    User[]            @relation("StudentCollege")
  images      CollegeImage[]
  places      CollegePlace[]
  submissions PlaceSubmission[]

  verifiedStudents     User[]                @relation("VerifiedStudentCollege")
  emailDomains         CollegeEmailDomain[]
  studentVerifications StudentVerification[]
  communityPosts       CommunityPost[]
  marketplaceListings  MarketplaceListing[]

  @@index([status])
  @@index([city, status])
  @@index([latitude, longitude])
  @@map("colleges")
}

model CollegeImage {
  id        String   @id @default(uuid(7)) @db.Char(36)
  collegeId String   @db.Char(36)
  // Only the URL is stored; image bytes never go into MySQL.
  imageUrl  String   @db.VarChar(1000)
  altText   String?  @db.VarChar(200)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId, sortOrder])
  @@map("college_images")
}

// A place can serve several colleges (College A -> ABC Mess, College B -> ABC Mess).
// `distanceMeters` is DERIVED from both coordinates (Haversine) by the application and is
// recomputed whenever either side moves. It is a cache that makes "nearest first" an indexed
// read; it is never the source of truth and is never hand-entered.
model CollegePlace {
  collegeId      String           @db.Char(36)
  placeId        String           @db.Char(36)
  distanceMeters Int
  // AUTO = within the college radius; PINNED = staff force-included; EXCLUDED = staff hid it.
  mode           CollegePlaceMode @default(AUTO)
  computedAt     DateTime         @default(now())

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  place   Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([collegeId, placeId])
  @@index([collegeId, distanceMeters])
  @@index([placeId])
  @@map("college_places")
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// Catalogue: categories, category-specific attributes, amenities
// ════════════════════════════════════════════════════════════════════════════════════════════

// Two-level tree (group -> category), fully data-driven: Accommodation -> Room / PG / Hostel.
model Category {
  id               String        @id @default(uuid(7)) @db.Char(36)
  parentId         String?       @db.Char(36)
  name             String        @db.VarChar(100)
  slug             String        @unique @db.VarChar(100)
  description      String?       @db.VarChar(500)
  // A key from the UI icon set, not a URL.
  icon             String?       @db.VarChar(50)
  status           ActiveStatus  @default(ACTIVE)
  sortOrder        Int           @default(0)
  // The unit prices are compared in within this category (e.g. MONTH for messes).
  defaultPriceUnit PriceUnit?
  // What kind of business this category is (drives the business dashboard's capabilities).
  // NULL = not a business category (or not decided): businesses in it count as OTHER.
  businessType     BusinessType?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  parent           Category?                 @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         Category[]                @relation("CategoryTree")
  attributes       CategoryAttribute[]
  ratingDimensions CategoryRatingDimension[]
  places           PlaceCategory[]
  submissions      PlaceSubmission[]
  businesses       BusinessProfile[]

  @@index([parentId, sortOrder])
  @@index([status])
  @@map("categories")
}

// Defines an extra field for a category (e.g. MESS -> veg_nonveg). Adding an attribute is a row,
// not a schema change. The values live in PlaceAttributeValue.
model CategoryAttribute {
  id         String            @id @default(uuid(7)) @db.Char(36)
  categoryId String            @db.Char(36)
  name       String            @db.VarChar(100)
  // Machine key, unique within the category.
  key        String            @db.VarChar(60)
  dataType   AttributeDataType
  required   Boolean           @default(false)
  filterable Boolean           @default(false)
  searchable Boolean           @default(false)
  // Display unit, e.g. "seats".
  unit       String?           @db.VarChar(20)
  // For ENUM / MULTI_ENUM: [{ "value": "veg", "label": "Veg" }, ...]
  options    Json?
  helpText   String?           @db.VarChar(255)
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  category Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values   PlaceAttributeValue[]

  @@unique([categoryId, key])
  @@index([categoryId, sortOrder])
  @@map("category_attributes")
}

// Optional rating dimensions per category (Mess: food / price / hygiene). Flexible replacement for
// hard-coded foodRating/priceRating columns on Review.
model CategoryRatingDimension {
  id         String   @id @default(uuid(7)) @db.Char(36)
  categoryId String   @db.Char(36)
  key        String   @db.VarChar(60)
  label      String   @db.VarChar(100)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  category Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  ratings  ReviewRating[]

  @@unique([categoryId, key])
  @@map("category_rating_dimensions")
}

// Master list of facilities (WiFi, AC, Parking, ...). Normalised: places link to rows here.
model Amenity {
  id        String       @id @default(uuid(7)) @db.Char(36)
  key       String       @unique @db.VarChar(60)
  name      String       @db.VarChar(100)
  icon      String?      @db.VarChar(50)
  status    ActiveStatus @default(ACTIVE)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  places PlaceAmenity[]

  @@index([status])
  @@map("amenities")
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// Places (ONE central table for messes, PGs, libraries, gyms, ...)
// ════════════════════════════════════════════════════════════════════════════════════════════

model Place {
  id                 String             @id @default(uuid(7)) @db.Char(36)
  name               String             @db.VarChar(200)
  slug               String             @unique @db.VarChar(200)
  description        String?            @db.Text
  address            String             @db.VarChar(500)
  city               String             @db.VarChar(100)
  state              String             @db.VarChar(100)
  country            String             @default("India") @db.VarChar(100)
  latitude           Float
  longitude          Float
  phone              String?            @db.VarChar(20)
  email              String?            @db.VarChar(254)
  website            String?            @db.VarChar(500)
  // Used only to open navigation in Google Maps. We never copy Google Maps business data.
  googleMapsUrl      String?            @db.VarChar(1000)
  // Comparable summary of PlacePriceOption (whole rupees), kept in sync by the application so
  // "cheapest first" is a plain indexed sort.
  priceMin           Int?
  priceMax           Int?
  priceUnit          PriceUnit?
  // Summary of published Reviews, maintained in the same transaction as the review write.
  ratingAverage      Float              @default(0)
  ratingCount        Int                @default(0)
  status             PlaceStatus        @default(DRAFT)
  verificationStatus VerificationStatus @default(PENDING)
  lastVerifiedAt     DateTime?
  verifiedById       String?            @db.Char(36)
  createdById        String             @db.Char(36)
  // Set when a business owns the listing (created it, or an approved PlaceClaim).
  businessProfileId  String?            @db.Char(36)
  isDemo             Boolean            @default(false)
  // Optimistic-concurrency counter for concurrent edits and contribution patches.
  version            Int                @default(1)
  publishedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  createdBy       User             @relation("PlaceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  verifiedBy      User?            @relation("PlaceVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  businessProfile BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)

  categories      PlaceCategory[]
  images          PlaceImage[]
  amenities       PlaceAmenity[]
  hours           PlaceHour[]
  attributeValues PlaceAttributeValue[]
  priceOptions    PlacePriceOption[]
  colleges        CollegePlace[]
  savedBy         SavedPlace[]
  claims          PlaceClaim[]
  contributions   PlaceContribution[]
  reviews         Review[]
  leads           Lead[]
  services        PlaceService[]
  dailyMenus      DailyMenu[]
  serviceItems    ServiceItem[]
  tables          PlaceTable[]
  qrCodes         PlaceQrCode[]
  serviceOrders   ServiceOrder[]
  dailyStats      PlaceDailyStat[]
  requestTypes    TableRequestType[]
  serviceRequests ServiceRequest[]
  offers          StudentOffer[]
  redemptions     OfferRedemption[]
  schedules       BookingSchedule[]
  bookings        Booking[]
  businessEvents  BusinessEvent[]
  createdFrom     PlaceSubmission[]     @relation("SubmissionResultingPlace")
  duplicatesOf    PlaceSubmission[]     @relation("SubmissionDuplicateOfPlace")

  @@index([status, city])
  @@index([status, createdAt])
  @@index([verificationStatus])
  @@index([businessProfileId])
  @@index([createdById])
  @@index([latitude, longitude])
  @@fulltext([name, description])
  @@map("places")
}

// A place can be in several categories (Study Point -> Library + Reading Room).
// Exactly one row per place should have isPrimary = true; enforced by the application because
// MySQL has no partial unique indexes.
model PlaceCategory {
  placeId    String   @db.Char(36)
  categoryId String   @db.Char(36)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  place    Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([placeId, categoryId])
  @@index([categoryId])
  @@map("place_categories")
}

model PlaceImage {
  id        String   @id @default(uuid(7)) @db.Char(36)
  placeId   String   @db.Char(36)
  // URL only (Cloudinary or local uploads); image bytes never go into MySQL.
  imageUrl  String   @db.VarChar(1000)
  altText   String?  @db.VarChar(200)
  isCover   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId, sortOrder])
  @@map("place_images")
}

model PlaceAmenity {
  placeId   String   @db.Char(36)
  amenityId String   @db.Char(36)
  createdAt DateTime @default(now())

  place   Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([placeId, amenityId])
  @@index([amenityId])
  @@map("place_amenities")
}

// Opening hours. A day may have several slots (a mess: lunch + dinner), distinguished by sortOrder.
// Times are "HH:mm" strings (24 h, place-local time). closeTime earlier than openTime means the
// slot runs past midnight. `is24Hours` and `isClosed` need no times.
// Special/holiday hours can be added later as a separate table without touching this one.
model PlaceHour {
  id        String  @id @default(uuid(7)) @db.Char(36)
  placeId   String  @db.Char(36)
  // ISO weekday: 1 = Monday ... 7 = Sunday.
  dayOfWeek Int     @db.TinyInt
  openTime  String? @db.VarChar(5)
  closeTime String? @db.VarChar(5)
  isClosed  Boolean @default(false)
  is24Hours Boolean @default(false)
  slotLabel String? @db.VarChar(50)
  sortOrder Int     @default(0)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, dayOfWeek, sortOrder])
  @@index([placeId])
  @@map("place_hours")
}

// The value of one CategoryAttribute for one place. Exactly one value column is used, chosen by
// the attribute's dataType.
model PlaceAttributeValue {
  id           String    @id @default(uuid(7)) @db.Char(36)
  placeId      String    @db.Char(36)
  attributeId  String    @db.Char(36)
  valueBoolean Boolean?
  valueNumber  Float?
  valueText    String?   @db.VarChar(255)
  valueDate    DateTime? @db.Date
  // MULTI_ENUM: ["single", "double"]
  valueJson    Json?

  place     Place             @relation(fields: [placeId], references: [id], onDelete: Cascade)
  attribute CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@unique([placeId, attributeId])
  @@index([attributeId, valueBoolean])
  @@index([attributeId, valueNumber])
  @@index([attributeId, valueText])
  @@map("place_attribute_values")
}

// One price point of a place: PG single/double/triple, mess veg/non-veg, library daily/monthly.
model PlacePriceOption {
  id        String    @id @default(uuid(7)) @db.Char(36)
  placeId   String    @db.Char(36)
  label     String    @db.VarChar(100)
  // Whole rupees.
  amount    Int
  unit      PriceUnit
  note      String?   @db.VarChar(255)
  sortOrder Int       @default(0)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@map("place_price_options")
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// Business owners
// ════════════════════════════════════════════════════════════════════════════════════════════

model BusinessProfile {
  id                 String             @id @default(uuid(7)) @db.Char(36)
  ownerId            String             @db.Char(36)
  businessName       String             @db.VarChar(200)
  slug               String             @unique @db.VarChar(200)
  description        String?            @db.Text
  phone              String?            @db.VarChar(20)
  email              String?            @db.VarChar(254)
  website            String?            @db.VarChar(500)
  logoUrl            String?            @db.VarChar(1000)
  // Wide banner at the top of the public business page.
  coverUrl           String?            @db.VarChar(1000)
  // What kind of business this is; chosen at sign-up. The listing's own categories may be several.
  categoryId         String?            @db.Char(36)
  city               String?            @db.VarChar(100)
  // Digits as typed; the page builds the wa.me link. Often the same number as `phone`.
  whatsapp           String?            @db.VarChar(20)
  instagramUrl       String?            @db.VarChar(500)
  facebookUrl        String?            @db.VarChar(500)
  status             BusinessStatus     @default(ACTIVE)
  verificationStatus VerificationStatus @default(PENDING)
  // Why staff rejected or suspended the business, shown to the owner. Cleared when reinstated.
  statusReason       String?            @db.VarChar(500)
  // Staff override of the business type; NULL = taken from the category.
  businessType       BusinessType?
  // The last invoice number issued (per business, gap-free, incremented in the invoice's transaction).
  invoiceSeq         Int                @default(0)
  // The places switched off when staff suspended or rejected the business, so reinstating it
  // brings back exactly those (and not a place staff deactivated for its own reasons).
  hiddenPlaceIds     Json?
  verifiedAt         DateTime?
  isDemo             Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  owner               User                         @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category            Category?                    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  members             BusinessMember[]
  places              Place[]
  claims              PlaceClaim[]
  leads               Lead[]
  serviceOrders       ServiceOrder[]
  serviceRequests     ServiceRequest[]
  offers              StudentOffer[]
  redemptions         OfferRedemption[]
  bookings            Booking[]
  events              BusinessEvent[]
  subscriptions       BusinessSubscription[]
  capabilityOverrides BusinessCapabilityOverride[]
  invoices            Invoice[]

  @@index([ownerId])
  @@index([status, verificationStatus])
  @@index([categoryId])
  @@index([city])
  @@index([createdAt])
  @@map("business_profiles")
}

// ── Plans (no payments yet: every business is on FREE unless staff assign another plan) ───────────

// A plan a business can be on. Data, not code: staff can prepare a plan (`isAvailable = false`)
// before it goes on sale. `priceMonthly` stays NULL until a real price is decided.
model BusinessPlan {
  id           String   @id @default(uuid(7)) @db.Char(36)
  key          String   @unique @db.VarChar(40)
  name         String   @db.VarChar(80)
  description  String   @db.VarChar(500)
  // Whole rupees a month; NULL = no price decided yet (shown as "coming soon", never as ₹0).
  priceMonthly Int?
  // What the plan includes, as short lines for the plan card.
  features     Json
  isAvailable  Boolean  @default(false)
  // The plan every business is on when it has no active subscription row.
  isDefault    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions BusinessSubscription[]

  @@map("business_plans")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

// A business on a plan for a period. At most one ACTIVE row per business (see `activeKey`); the
// ended rows are the history. A payment gateway would later create these rows instead of staff.
model BusinessSubscription {
  id                String             @id @default(uuid(7)) @db.Char(36)
  businessProfileId String             @db.Char(36)
  planId            String             @db.Char(36)
  status            SubscriptionStatus @default(ACTIVE)
  startedAt         DateTime           @default(now())
  // NULL = until changed.
  endsAt            DateTime?
  endedAt           DateTime?
  assignedById      String?            @db.Char(36)
  note              String?            @db.VarChar(500)
  // The business id while ACTIVE, NULL once ended: UNIQUE, so two active plans can never coexist.
  activeKey         String?            @unique @db.Char(36)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  plan            BusinessPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  assignedBy      User?           @relation("SubscriptionAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([businessProfileId, createdAt])
  @@index([planId, status])
  @@map("business_subscriptions")
}

// ── Business types and capabilities ─────────────────────────────────────────────────────────────

enum BusinessType {
  HOTEL_RESTAURANT
  MESS
  PG
  ROOM_RENTAL
  LIBRARY
  PRINTING_XEROX
  SALON
  SERVICE
  OTHER
}

// What a business can do on CampusPin. Each gates dashboard modules AND their APIs.
enum BusinessCapability {
  ORDER_MANAGEMENT
  TABLE_ORDER
  INVOICE
  PAYMENT
  BOOKING
  ENQUIRY
  SERVICE_REQUEST
  MEMBERSHIP
  APPOINTMENT
  REVENUE_ANALYTICS
}

// The default capabilities of each business type. Data, so a type's modules change without code.
model BusinessTypeCapability {
  businessType BusinessType
  capability   BusinessCapability
  createdAt    DateTime           @default(now())

  @@id([businessType, capability])
  @@map("business_type_capabilities")
}

// Staff turning one capability on or off for one business, over its type's defaults.
model BusinessCapabilityOverride {
  businessProfileId String             @db.Char(36)
  capability        BusinessCapability
  enabled           Boolean
  note              String?            @db.VarChar(255)
  setById           String?            @db.Char(36)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  setBy           User?           @relation("CapabilityOverrideSetBy", fields: [setById], references: [id], onDelete: SetNull)

  @@id([businessProfileId, capability])
  @@map("business_capability_overrides")
}

// ── Payments and invoices ────────────────────────────────────────────────────────────────────────

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentChannel {
  CASH
  UPI
  CARD
  ONLINE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

// The bill of one completed order. At most one per order (orderId is unique). The business and
// customer details are copied at issue time, so a later rename never changes an issued invoice.
model Invoice {
  id                String        @id @default(uuid(7)) @db.Char(36)
  // Per business: e.g. SGM-2026-0001 (prefix from the business, then year and sequence).
  number            String        @db.VarChar(40)
  businessProfileId String        @db.Char(36)
  orderId           String        @unique @db.Char(36)
  userId            String?       @db.Char(36)
  status            InvoiceStatus @default(ISSUED)
  businessName      String        @db.VarChar(200)
  businessAddress   String        @db.VarChar(700)
  businessPhone     String?       @db.VarChar(20)
  businessEmail     String?       @db.VarChar(254)
  customerName      String        @db.VarChar(120)
  subtotal          Int
  discount          Int           @default(0)
  // No tax is configured on CampusPin yet; kept so a configured tax never needs a migration.
  tax               Int           @default(0)
  total             Int
  issuedAt          DateTime      @default(now())
  paidAt            DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Restrict)
  order           ServiceOrder    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user            User?           @relation("InvoiceCustomer", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([businessProfileId, number])
  @@index([businessProfileId, issuedAt])
  @@index([businessProfileId, status])
  @@index([userId])
  @@map("invoices")
}

enum BusinessEventType {
  PAGE_VIEW
  PHONE_CLICK
  WHATSAPP_CLICK
  DIRECTION_CLICK
  SHARE_CLICK
}

// One visit or tap on a public business page, for the owner's analytics. Deliberately anonymous:
// no user, IP or device, only what happened, where and when. `day` is the IST calendar day, so
// "per day" charts are a plain indexed GROUP BY.
model BusinessEvent {
  id                String            @id @default(uuid(7)) @db.Char(36)
  businessProfileId String            @db.Char(36)
  placeId           String?           @db.Char(36)
  type              BusinessEventType
  day               DateTime          @db.Date
  createdAt         DateTime          @default(now())

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  place           Place?          @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([businessProfileId, day, type])
  @@index([placeId])
  @@map("business_events")
}

// Lets several people manage one business. A user can appear at most once per business.
model BusinessMember {
  businessProfileId String             @db.Char(36)
  userId            String             @db.Char(36)
  role              BusinessMemberRole @default(STAFF)
  createdAt         DateTime           @default(now())

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([businessProfileId, userId])
  @@index([userId])
  @@map("business_members")
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// Ownership claims and community contributions (all moderated; history is kept)
// ════════════════════════════════════════════════════════════════════════════════════════════

// "Is this your business? Claim this listing." Approval links Place.businessProfileId.
model PlaceClaim {
  id                String      @id @default(uuid(7)) @db.Char(36)
  placeId           String      @db.Char(36)
  businessProfileId String      @db.Char(36)
  requestedById     String      @db.Char(36)
  status            ClaimStatus @default(PENDING)
  message           String?     @db.Text
  verificationNote  String?     @db.Text
  reviewedById      String?     @db.Char(36)
  reviewedAt        DateTime?
  // "<placeId>:<businessProfileId>" while the claim is open (PENDING), NULL once decided.
  // UNIQUE, so the same business cannot have two open claims on one place. MySQL allows many NULLs.
  activeKey         String?     @unique @db.VarChar(80)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  place           Place           @relation(fields: [placeId], references: [id], onDelete: Restrict)
  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Restrict)
  requestedBy     User            @relation("ClaimRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy      User?           @relation("ClaimReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([placeId, status])
  @@index([businessProfileId])
  @@index([status, createdAt])
  @@index([requestedById])
  @@map("place_claims")
}

// A student proposes a NEW place. It is never published directly: staff approve it (creating a
// Place, see resultingPlaceId) or mark it as a duplicate of an existing Place.
model PlaceSubmission {
  id                  String           @id @default(uuid(7)) @db.Char(36)
  name                String           @db.VarChar(200)
  categoryId          String           @db.Char(36)
  // The college page the student was browsing (context only).
  collegeId           String?          @db.Char(36)
  address             String           @db.VarChar(500)
  city                String?          @db.VarChar(100)
  latitude            Float
  longitude           Float
  phone               String?          @db.VarChar(20)
  priceAmount         Int?
  priceUnit           PriceUnit?
  description         String?          @db.Text
  status              SubmissionStatus @default(PENDING)
  submittedById       String           @db.Char(36)
  reviewedById        String?          @db.Char(36)
  reviewedAt          DateTime?
  reviewNote          String?          @db.Text
  // Set when approved.
  resultingPlaceId    String?          @db.Char(36)
  // Set when staff conclude it already exists.
  duplicateOfPlaceId  String?          @db.Char(36)
  // Output of duplicate detection at submit time: [{ placeId, score, reasons[] }].
  duplicateCandidates Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  category         Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  college          College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  submittedBy      User     @relation("SubmissionSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy       User?    @relation("SubmissionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  resultingPlace   Place?   @relation("SubmissionResultingPlace", fields: [resultingPlaceId], references: [id], onDelete: SetNull)
  duplicateOfPlace Place?   @relation("SubmissionDuplicateOfPlace", fields: [duplicateOfPlaceId], references: [id], onDelete: SetNull)

  images PlaceSubmissionImage[]

  @@index([status, createdAt])
  @@index([submittedById])
  @@index([categoryId])
  @@map("place_submissions")
}

model PlaceSubmissionImage {
  id           String   @id @default(uuid(7)) @db.Char(36)
  submissionId String   @db.Char(36)
  imageUrl     String   @db.VarChar(1000)
  altText      String?  @db.VarChar(200)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  submission PlaceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, sortOrder])
  @@map("place_submission_images")
}

// A suggested change to an EXISTING place (new phone, new price, new photo, corrected timing, ...)
// so that students improve data instead of creating duplicate places. Moderated before it is applied.
model PlaceContribution {
  id              String             @id @default(uuid(7)) @db.Char(36)
  placeId         String             @db.Char(36)
  contributedById String             @db.Char(36)
  type            ContributionType
  // The proposed change, validated by the application per type, e.g. { "phone": "..." }.
  payload         Json
  note            String?            @db.Text
  status          ContributionStatus @default(PENDING)
  // Place.version when the change was proposed, so stale patches can be detected.
  baseVersion     Int?
  reviewedById    String?            @db.Char(36)
  reviewedAt      DateTime?
  reviewNote      String?            @db.Text
  appliedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  place         Place @relation(fields: [placeId], references: [id], onDelete: Restrict)
  contributedBy User  @relation("ContributionContributedBy", fields: [contributedById], references: [id], onDelete: Restrict)
  reviewedBy    User? @relation("ContributionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([placeId, status])
  @@index([status, createdAt])
  @@index([contributedById])
  @@map("place_contributions")
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// Reviews and saved places
// ════════════════════════════════════════════════════════════════════════════════════════════

model Review {
  id             String       @id @default(uuid(7)) @db.Char(36)
  placeId        String       @db.Char(36)
  userId         String       @db.Char(36)
  // Overall rating, 1..5 (CHECK constraint in the migration).
  rating         Int          @db.TinyInt
  comment        String?      @db.Text
  status         ReviewStatus @default(PUBLISHED)
  moderationNote String?      @db.VarChar(500)
  moderatedById  String?      @db.Char(36)
  moderatedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  place       Place @relation(fields: [placeId], references: [id], onDelete: Restrict)
  user        User  @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Restrict)
  moderatedBy User? @relation("ReviewModeratedBy", fields: [moderatedById], references: [id], onDelete: SetNull)

  ratings ReviewRating[]
  reports ReviewReport[]

  // One review per user per place: prevents rating spam.
  @@unique([placeId, userId])
  @@index([placeId, status, createdAt])
  @@index([userId])
  @@index([status])
  @@map("reviews")
}

// Optional per-dimension rating (Food 5, Price 4, ...) chosen from the place's category dimensions.
model ReviewRating {
  reviewId    String @db.Char(36)
  dimensionId String @db.Char(36)
  // 1..5 (CHECK constraint in the migration).
  rating      Int    @db.TinyInt

  review    Review                  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  dimension CategoryRatingDimension @relation(fields: [dimensionId], references: [id], onDelete: Restrict)

  @@id([reviewId, dimensionId])
  @@index([dimensionId])
  @@map("review_ratings")
}

// A user reporting a review. One report per user per review.
model ReviewReport {
  id             String       @id @default(uuid(7)) @db.Char(36)
  reviewId       String       @db.Char(36)
  reportedById   String       @db.Char(36)
  reason         ReportReason
  description    String?      @db.Text
  status         ReportStatus @default(PENDING)
  reviewedById   String?      @db.Char(36)
  reviewedAt     DateTime?
  resolutionNote String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  review     Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reportedBy User   @relation("ReviewReportReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)
  reviewedBy User?  @relation("ReviewReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([reviewId, reportedById])
  @@index([status, createdAt])
  @@index([reviewId])
  @@map("review_reports")
}

// A student's enquiry to the business that manages a place ("Is a double room free from July?").
// Only places with a business can receive one: nobody would read it otherwise.
model Lead {
  id                String     @id @default(uuid(7)) @db.Char(36)
  placeId           String     @db.Char(36)
  // Place.businessProfileId when the enquiry was sent (denormalised): the business's inbox is keyed
  // on it, and an enquiry stays with the business it was sent to even if the place changes hands.
  businessProfileId String     @db.Char(36)
  userId            String     @db.Char(36)
  message           String     @db.Text
  // The number the student wants to be called back on; the business also sees their name and email.
  contactPhone      String?    @db.VarChar(20)
  // When the student agreed to share their contact details with this business.
  consentAt         DateTime
  status            LeadStatus @default(NEW)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  place           Place           @relation(fields: [placeId], references: [id], onDelete: Cascade)
  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  user            User            @relation("LeadSender", fields: [userId], references: [id], onDelete: Cascade)

  @@index([placeId, status, createdAt])
  @@index([businessProfileId, createdAt])
  @@index([userId])
  @@map("leads")
}

model SavedPlace {
  userId    String   @db.Char(36)
  placeId   String   @db.Char(36)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  // The composite primary key makes a duplicate save impossible.
  @@id([userId, placeId])
  @@index([placeId])
  @@map("saved_places")
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// Moderation, notifications, audit
// ════════════════════════════════════════════════════════════════════════════════════════════

// Generic moderation report. Its target is (targetType, targetId), so a new reportable entity
// (marketplace listing, community post, ...) only needs a new ReportTargetType value: no new
// table. There is deliberately no database foreign key on the target; ReportsService checks it.
// (Reviews additionally have the FK-enforced ReviewReport above.)
model Report {
  id           String           @id @default(uuid(7)) @db.Char(36)
  reporterId   String           @db.Char(36)
  targetType   ReportTargetType
  targetId     String           @db.Char(36)
  reason       ReportReason
  description  String?          @db.Text
  status       ReportStatus     @default(PENDING)
  resolution   String?          @db.Text
  resolvedById String?          @db.Char(36)
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  resolvedBy User? @relation("ReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("reports")
}

// In-app notifications. Email/push delivery is added later on top of this (a delivery table),
// without changing this one.
model Notification {
  id        String    @id @default(uuid(7)) @db.Char(36)
  userId    String    @db.Char(36)
  // Free-form key such as "place.approved"; new kinds need no schema change.
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(200)
  message   String    @db.Text
  // Deep-link payload, e.g. { "placeId": "..." }.
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// Append-only record of who did what. The actor is kept as NULL if the user is ever removed.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Char(36)
  actorId    String?  @db.Char(36)
  // e.g. "place.approve", "user.suspend"
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(50)
  entityId   String?  @db.VarChar(36)
  metadata   Json?
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(255)
  requestId  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// Student verification, member settings
// ════════════════════════════════════════════════════════════════════════════════════════════

// An official email domain of a college ("abccollege.edu.in"). A college email proves affiliation
// only if its domain is listed here for the college the student chose. One domain, one college.
model CollegeEmailDomain {
  id          String   @id @default(uuid(7)) @db.Char(36)
  collegeId   String   @db.Char(36)
  // Lowercase, no "@".
  domain      String   @unique @db.VarChar(253)
  createdById String?  @db.Char(36)
  createdAt   DateTime @default(now())

  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([collegeId])
  @@map("college_email_domains")
}

// One attempt to prove "I am a student of this college". History is kept: a new attempt is a new
// row. Only what verification needs is stored; a document is deleted once staff decide.
model StudentVerification {
  id               String                    @id @default(uuid(7)) @db.Char(36)
  userId           String                    @db.Char(36)
  collegeId        String                    @db.Char(36)
  method           StudentVerificationMethod
  status           StudentVerificationStatus @default(PENDING)
  // COLLEGE_EMAIL: the (lowercase) college address the code was sent to.
  collegeEmail     String?                   @db.VarChar(254)
  // Set only while VERIFIED by email, so one college mailbox backs one account at a time.
  verifiedEmailKey String?                   @unique @db.VarChar(254)
  // SHA-256 of the one-time code; the code itself is never stored.
  codeHash         String?                   @db.Char(64)
  codeExpiresAt    DateTime?
  codeAttempts     Int                       @default(0)
  // DOCUMENT: the key of the file in PRIVATE storage (never a public URL). Cleared once decided.
  documentKey      String?                   @db.VarChar(255)
  documentType     String?                   @db.VarChar(40)
  // Shown to the student (why it was rejected / why to verify again). Never shown to others.
  reviewNote       String?                   @db.VarChar(500)
  reviewedById     String?                   @db.Char(36)
  reviewedAt       DateTime?
  verifiedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  user       User    @relation("StudentVerificationUser", fields: [userId], references: [id], onDelete: Cascade)
  college    College @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  reviewedBy User?   @relation("StudentVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([collegeId, status])
  @@index([status, createdAt])
  @@map("student_verifications")
}

// A member's privacy and notification choices. The row is created on first change; until then the
// defaults below apply (private by default: contact details are never public at all).
model UserSettings {
  userId                   String            @id @db.Char(36)
  profileVisibility        ProfileVisibility @default(STUDENTS)
  showCommunityActivity    Boolean           @default(true)
  allowMarketplaceMessages Boolean           @default(true)
  notifyCommunity          Boolean           @default(true)
  notifyMarketplace        Boolean           @default(true)
  notifyEvents             Boolean           @default(true)
  notifyJobs               Boolean           @default(true)
  notifyMessages           Boolean           @default(true)
  // Menus and offers from places the member saved.
  notifyPlaceUpdates       Boolean           @default(true)
  updatedAt                DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

enum CommunityCategory {
  DISCUSSION
  QUESTION
  ANNOUNCEMENT
  EVENT
  STUDY
  JOB
  LOST_FOUND
  STUDENT_UPDATE
}

enum CommunityVisibility {
  COLLEGE_ONLY
  PUBLIC
}

// ACTIVE is shown; HIDDEN is a moderator's reversible hold; REMOVED is final (by the author or a
// moderator). Rows are never hard-deleted, so reports and audit entries keep their target.
enum CommunityContentStatus {
  ACTIVE
  HIDDEN
  REMOVED
}

enum CommunityReactionType {
  LIKE
  HELPFUL
  CELEBRATE
}

// A post in one college's community. collegeId is copied from the author's verified college when
// the post is written and never taken from the request.
model CommunityPost {
  id             String                 @id @default(uuid(7)) @db.Char(36)
  authorId       String                 @db.Char(36)
  collegeId      String                 @db.Char(36)
  category       CommunityCategory
  visibility     CommunityVisibility    @default(COLLEGE_ONLY)
  // Optional: chat messages have none, longer posts may.
  title          String?                @db.VarChar(150)
  body           String                 @db.Text
  // The message this one replies to (WhatsApp-style quote), in the same college chat.
  replyToId      String?                @db.Char(36)
  // EVENT posts only.
  eventStartsAt  DateTime?
  eventLocation  String?                @db.VarChar(200)
  status         CommunityContentStatus @default(ACTIVE)
  moderationNote String?                @db.VarChar(500)
  commentCount   Int                    @default(0)
  reactionCount  Int                    @default(0)
  editedAt       DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  author    User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  college   College             @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  comments  CommunityComment[]
  reactions CommunityReaction[]
  replyTo   CommunityPost?      @relation("PostReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   CommunityPost[]     @relation("PostReplies")

  @@index([collegeId, category, status, id])
  @@index([collegeId, status, createdAt])
  @@index([visibility, status, createdAt])
  @@index([authorId, createdAt])
  @@map("community_posts")
}

// A comment, or a reply to one (one level deep: a reply's parent is always a top-level comment).
model CommunityComment {
  id        String                 @id @default(uuid(7)) @db.Char(36)
  postId    String                 @db.Char(36)
  authorId  String                 @db.Char(36)
  parentId  String?                @db.Char(36)
  body      String                 @db.Text
  status    CommunityContentStatus @default(ACTIVE)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  post    CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  CommunityComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies CommunityComment[] @relation("CommentReplies")

  @@index([postId, status, createdAt])
  @@index([authorId])
  @@map("community_comments")
}

// One reaction per member per post; reacting again changes its type.
model CommunityReaction {
  postId    String                @db.Char(36)
  userId    String                @db.Char(36)
  type      CommunityReactionType
  createdAt DateTime              @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("community_reactions")
}

// "I don't want to see or hear from this member." It hides both ways: neither sees the other's
// posts, comments or listings, and neither can message the other.
model UserBlock {
  blockerId String   @db.Char(36)
  blockedId String   @db.Char(36)
  createdAt DateTime @default(now())

  blocker User @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

enum ListingCategory {
  BOOKS
  NOTES
  ELECTRONICS
  FURNITURE
  CYCLES
  HOSTEL_ESSENTIALS
  CLOTHING
  SPORTS
  STATIONERY
  OTHER
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ListingVisibility {
  MY_COLLEGE
  NEARBY_COLLEGES
  CITY
}

// HIDDEN is a moderator's reversible hold; REMOVED is final. EXPIRED is also derived from
// expiresAt when reading, so a listing never shows past its end date even before a sweep.
enum ListingStatus {
  ACTIVE
  RESERVED
  SOLD
  EXPIRED
  HIDDEN
  REMOVED
}

// Something a verified student sells. collegeId is the seller's verified college when listed (never
// taken from the request); its city and coordinates decide who sees the listing.
model MarketplaceListing {
  id             String            @id @default(uuid(7)) @db.Char(36)
  sellerId       String            @db.Char(36)
  collegeId      String            @db.Char(36)
  title          String            @db.VarChar(120)
  description    String            @db.Text
  category       ListingCategory
  condition      ListingCondition
  // Whole rupees; 0 = free.
  price          Int
  negotiable     Boolean           @default(false)
  quantity       Int               @default(1)
  // A pickup point in words ("Main gate"), never an address or a phone number.
  location       String?           @db.VarChar(120)
  visibility     ListingVisibility @default(NEARBY_COLLEGES)
  status         ListingStatus     @default(ACTIVE)
  moderationNote String?           @db.VarChar(500)
  expiresAt      DateTime
  soldAt         DateTime?
  // Credits paid for it when the free listings were used up; 0 = a free listing.
  creditsSpent   Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  seller        User                      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  college       College                   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  images        MarketplaceListingImage[]
  conversations Conversation[]
  creditEntries ListingCreditEntry[]

  @@index([status, collegeId, expiresAt])
  @@index([sellerId, status])
  @@index([status, price])
  @@map("marketplace_listings")
}

// Photos of a listing: URLs of files stored by the uploads endpoint, in display order.
model MarketplaceListingImage {
  id        String   @id @default(uuid(7)) @db.Char(36)
  listingId String   @db.Char(36)
  imageUrl  String   @db.VarChar(500)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("marketplace_listing_images")
}

// One buyer talking to one seller about one listing.
model Conversation {
  id               String    @id @default(uuid(7)) @db.Char(36)
  listingId        String    @db.Char(36)
  buyerId          String    @db.Char(36)
  sellerId         String    @db.Char(36)
  lastMessageAt    DateTime
  buyerLastReadAt  DateTime?
  sellerLastReadAt DateTime?
  createdAt        DateTime  @default(now())

  listing  MarketplaceListing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer    User                  @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User                  @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@unique([listingId, buyerId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
  @@map("conversations")
}

model ConversationMessage {
  id             String   @id @default(uuid(7)) @db.Char(36)
  conversationId String   @db.Char(36)
  senderId       String   @db.Char(36)
  body           String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, id])
  @@map("conversation_messages")
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// Promotions (in-app ads and announcements)
// ════════════════════════════════════════════════════════════════════════════════════════════

enum PromotionPlacement {
  SPLASH // full screen when the app opens
  FEED // a card in the "Featured" section of the student home and the business dashboard
}

enum PromotionAudience {
  ALL
  STUDENTS
  BUSINESSES
}

enum PromotionKind {
  ANNOUNCEMENT
  NEW_FEATURE
  SPONSORED
}

// What staff show inside the apps: news about CampusPin, or a boosted business. Shown while
// `active` and inside [startsAt, endsAt) (open ends mean "no limit"); highest priority first.
model Promotion {
  id               String             @id @default(uuid(7)) @db.Char(36)
  placement        PromotionPlacement
  kind             PromotionKind      @default(ANNOUNCEMENT)
  audience         PromotionAudience  @default(ALL)
  title            String             @db.VarChar(80)
  body             String?            @db.VarChar(300)
  // A file stored by the uploads endpoint.
  imageUrl         String?            @db.VarChar(500)
  ctaLabel         String?            @db.VarChar(30)
  // An app path ("/places/sai-mess") or an https link.
  ctaLink          String?            @db.VarChar(500)
  // SPLASH only: seconds on screen, and after how many the close button appears.
  displaySeconds   Int                @default(10)
  skipAfterSeconds Int                @default(5)
  active           Boolean            @default(true)
  priority         Int                @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  // Rough reach, counted when an app shows or opens it; not unique per member.
  views            Int                @default(0)
  clicks           Int                @default(0)
  createdById      String?            @db.Char(36)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  createdBy User? @relation("PromotionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([placement, active, priority])
  @@map("promotions")
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// Platform settings and marketplace listing credits
// ════════════════════════════════════════════════════════════════════════════════════════════

// Settings a super admin changes at runtime, one JSON value per key (e.g. "marketplace.listingLimits").
// A missing row means the default in code.
model PlatformSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedById String?  @db.Char(36)
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

enum CreditReason {
  ADMIN_GRANT
  ADMIN_DEDUCT
  LISTING
}

// Every change to a student's listing credits. Balance = the starting credits in the settings +
// the sum of these amounts, so changing the starting amount applies to everyone at once.
model ListingCreditEntry {
  id        String       @id @default(uuid(7)) @db.Char(36)
  userId    String       @db.Char(36)
  // Positive = credits given, negative = credits spent or taken away.
  amount    Int
  reason    CreditReason
  listingId String?      @db.Char(36)
  note      String?      @db.VarChar(200)
  actorId   String?      @db.Char(36)
  createdAt DateTime     @default(now())

  user    User                @relation("CreditEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?               @relation("CreditEntryActor", fields: [actorId], references: [id], onDelete: SetNull)
  listing MarketplaceListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("listing_credit_entries")
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// Activity analytics
// ════════════════════════════════════════════════════════════════════════════════════════════

// One row per device per day (India time). The key is a random id the browser or phone keeps, so
// no IP address or other personal data is stored. A signed-in visit also records the account.
model DailyVisit {
  day         DateTime @db.Date
  visitorKey  String   @db.VarChar(64)
  userId      String?  @db.Char(36)
  // STUDENT, BUSINESS or STAFF when signed in; null for a guest.
  audience    String?  @db.VarChar(16)
  // "web" or "mobile"
  client      String   @db.VarChar(10)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@id([day, visitorKey])
  @@index([day, userId])
  @@index([userId])
  @@map("daily_visits")
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// Daily-use services: what a place lets students DO through CampusPin (order, print, book, ...)
// ════════════════════════════════════════════════════════════════════════════════════════════

// How a service works. The behaviour (screens, state machine) is chosen by the kind; the service
// types themselves are data, so admins can add "Tailoring" as another SERVICE_REQUEST without code.
enum ServiceKind {
  // Menu + cart ordering (restaurant, cafe, canteen), optionally at a table.
  FOOD_ORDER
  // A mess publishing its menu for the day.
  DAILY_MENU
  // Water / bill / call-staff requests from a table.
  TABLE_SERVICE
  // Upload a PDF, choose copies and options, pick it up.
  PRINT_ORDER
  // Describe a job; the business accepts, estimates and completes it (repair, laundry).
  SERVICE_REQUEST
  // Time-slot or whole-day bookings (salon, study seat, sports court).
  BOOKING
  // Student offers and their redemption.
  OFFERS
  // Discovery only: opens the places of a category (Find Room).
  LISTING
}

// One quick action / service a business can switch on. Seeded; admins manage the list.
model ServiceType {
  id           String       @id @default(uuid(7)) @db.Char(36)
  // Stable machine key used by the apps, e.g. ORDER_FOOD.
  key          String       @unique @db.VarChar(40)
  name         String       @db.VarChar(60)
  description  String?      @db.VarChar(255)
  // A key from the UI icon set, not a URL.
  icon         String?      @db.VarChar(50)
  kind         ServiceKind
  // Shown as a quick action on the student home screen.
  showOnHome   Boolean      @default(false)
  // LISTING kind: the category group or category it opens (e.g. "accommodation").
  categorySlug String?      @db.VarChar(100)
  status       ActiveStatus @default(ACTIVE)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  placeServices PlaceService[]
  items         ServiceItem[]
  requests      ServiceRequest[]
  schedules     BookingSchedule[]
  bookings      Booking[]

  @@index([status, sortOrder])
  @@map("service_types")
}

// A service switched on (or off) for one place. The owner controls `enabled`; staff can override
// with `disabledByAdmin`, which wins. Kind-specific settings live in `config` (validated by the API).
model PlaceService {
  id              String   @id @default(uuid(7)) @db.Char(36)
  placeId         String   @db.Char(36)
  serviceTypeId   String   @db.Char(36)
  enabled         Boolean  @default(true)
  // e.g. { "acceptingOrders": true } or { "seats": 40, "bookingEnabled": false }
  config          Json?
  disabledByAdmin Boolean  @default(false)
  adminNote       String?  @db.VarChar(255)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  place       Place       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)

  @@unique([placeId, serviceTypeId])
  @@index([serviceTypeId, enabled])
  @@map("place_services")
}

enum MenuStatus {
  DRAFT
  PUBLISHED
  // Taken down by staff (inappropriate content); only staff and the owner see it.
  REMOVED
}

enum MealSlot {
  BREAKFAST
  LUNCH
  SNACKS
  DINNER
}

// A mess's menu for one day (India date). One per place per day.
model DailyMenu {
  id            String     @id @default(uuid(7)) @db.Char(36)
  placeId       String     @db.Char(36)
  date          DateTime   @db.Date
  status        MenuStatus @default(DRAFT)
  note          String?    @db.VarChar(255)
  publishedAt   DateTime?
  removedReason String?    @db.VarChar(255)
  createdById   String?    @db.Char(36)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  place     Place           @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("DailyMenuCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     DailyMenuItem[]

  @@unique([placeId, date])
  @@index([date, status])
  @@map("daily_menus")
}

model DailyMenuItem {
  id        String   @id @default(uuid(7)) @db.Char(36)
  menuId    String   @db.Char(36)
  meal      MealSlot
  name      String   @db.VarChar(100)
  sortOrder Int      @default(0)

  menu DailyMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId, meal, sortOrder])
  @@map("daily_menu_items")
}

// One thing a place sells through a service: a dish on the food menu, a repair, a haircut, a study
// seat. Reused by every kind that has a price list: one catalogue, not one per business type.
model ServiceItem {
  id              String   @id @default(uuid(7)) @db.Char(36)
  placeId         String   @db.Char(36)
  serviceTypeId   String   @db.Char(36)
  // Menu category / group, e.g. "Breakfast", "Beverages".
  section         String   @default("") @db.VarChar(60)
  name            String   @db.VarChar(100)
  description     String?  @db.VarChar(300)
  // Whole rupees.
  price           Int
  // Food only: true = veg, false = non-veg, null = not said.
  isVeg           Boolean?
  // Add-ons the student may pick: [{ "name": "Extra cheese", "price": 20 }]
  options         Json?
  available       Boolean  @default(true)
  sortOrder       Int      @default(0)
  // Bookable items: minutes per slot (null = a whole-day booking, e.g. a study seat for the day).
  durationMinutes Int?
  // Bookable items: bookings allowed in one slot (chairs, seats, courts).
  capacity        Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  place       Place              @relation(fields: [placeId], references: [id], onDelete: Cascade)
  serviceType ServiceType        @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  orderItems  ServiceOrderItem[]
  requests    ServiceRequest[]
  bookings    Booking[]

  @@index([placeId, serviceTypeId, sortOrder])
  @@map("service_items")
}

// A table in a restaurant or cafe ("Table 07"). Future: rooms, library seats, counters.
model PlaceTable {
  id        String       @id @default(uuid(7)) @db.Char(36)
  placeId   String       @db.Char(36)
  label     String       @db.VarChar(30)
  status    ActiveStatus @default(ACTIVE)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  place    Place            @relation(fields: [placeId], references: [id], onDelete: Cascade)
  qrCodes  PlaceQrCode[]
  orders   ServiceOrder[]
  requests ServiceRequest[]

  @@unique([placeId, label])
  @@map("place_tables")
}

enum QrKind {
  BUSINESS
  TABLE
}

enum QrStatus {
  ACTIVE
  DISABLED
  // A newer code was generated for the same target (a leaked or damaged print).
  REPLACED
}

// A printed CampusPin QR code. The random token is the only thing in the printed URL: no database
// id is ever exposed. At most one ACTIVE code per target, enforced with activeKey.
model PlaceQrCode {
  id            String    @id @default(uuid(7)) @db.Char(36)
  token         String    @unique @db.VarChar(32)
  placeId       String    @db.Char(36)
  kind          QrKind
  tableId       String?   @db.Char(36)
  status        QrStatus  @default(ACTIVE)
  // "<placeId>:<kind>:<tableId or ->" while ACTIVE, NULL otherwise.
  activeKey     String?   @unique @db.VarChar(90)
  scanCount     Int       @default(0)
  lastScannedAt DateTime?
  createdById   String?   @db.Char(36)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  place     Place       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  table     PlaceTable? @relation(fields: [tableId], references: [id], onDelete: Cascade)
  createdBy User?       @relation("QrCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([placeId, kind])
  @@map("place_qr_codes")
}

enum OrderKind {
  FOOD
  PRINT
}

// One lifecycle for every kind; each kind allows only its own moves (see order-rules.ts).
enum OrderStatus {
  PENDING
  ACCEPTED
  // Food: preparing. Print: processing.
  PREPARING
  // Food: ready. Print: ready for pickup.
  READY
  SERVED
  COMPLETED
  CANCELLED
  REJECTED
}

// No card data is ever stored. Online payment would add a payments table keyed on the order.
enum PaymentMethod {
  PAY_AT_COUNTER
  CASH_AT_TABLE
}

// An order a student placed with a business. Totals are always computed by the server from the
// catalogue at order time; item names and prices are copied so later menu edits never change it.
model ServiceOrder {
  id                String          @id @default(uuid(7)) @db.Char(36)
  // Short code said at the counter, e.g. CP7K2Q9M.
  code              String          @unique @db.VarChar(12)
  kind              OrderKind
  placeId           String          @db.Char(36)
  // Denormalised: the business inbox is keyed on it.
  businessProfileId String          @db.Char(36)
  userId            String          @db.Char(36)
  tableId           String?         @db.Char(36)
  // Copied so the order still reads right if the table is renamed or deleted.
  tableLabel        String?         @db.VarChar(30)
  status            OrderStatus     @default(PENDING)
  subtotal          Int
  discount          Int             @default(0)
  total             Int
  paymentMethod     PaymentMethod   @default(PAY_AT_COUNTER)
  // Separate from `status`: a completed order is not necessarily paid.
  paymentStatus     PaymentStatus   @default(UNPAID)
  paidAt            DateTime?
  // How it was actually paid, recorded by the business (or a gateway later).
  paidVia           PaymentChannel?
  completedAt       DateTime?
  cancelledAt       DateTime?
  note              String?         @db.VarChar(300)
  // Print orders: the student's document (private) and the chosen options.
  documentId        String?         @unique @db.Char(36)
  printOptions      Json?
  // The client's retry key: the same key never creates a second order.
  idempotencyKey    String          @db.VarChar(64)
  statusReason      String?         @db.VarChar(255)
  statusChangedAt   DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  place           Place              @relation(fields: [placeId], references: [id], onDelete: Restrict)
  businessProfile BusinessProfile    @relation(fields: [businessProfileId], references: [id], onDelete: Restrict)
  user            User               @relation("ServiceOrderStudent", fields: [userId], references: [id], onDelete: Restrict)
  table           PlaceTable?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items           ServiceOrderItem[]
  redemption      OfferRedemption?
  document        PrivateDocument?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  invoice         Invoice?

  @@unique([userId, idempotencyKey])
  @@index([businessProfileId, status, createdAt])
  @@index([businessProfileId, paymentStatus])
  @@index([placeId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("service_orders")
}

model ServiceOrderItem {
  id            String  @id @default(uuid(7)) @db.Char(36)
  orderId       String  @db.Char(36)
  serviceItemId String? @db.Char(36)
  name          String  @db.VarChar(100)
  // Price of one, add-ons included, in whole rupees.
  unitPrice     Int
  quantity      Int
  // The add-ons chosen: [{ "name": "Extra cheese", "price": 20 }]
  options       Json?
  lineTotal     Int

  order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceItem ServiceItem? @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("service_order_items")
}

// Per place per India day: page views and QR scans, counted from when this table was added (no
// back-filled or invented numbers).
model PlaceDailyStat {
  placeId String   @db.Char(36)
  day     DateTime @db.Date
  views   Int      @default(0)
  qrScans Int      @default(0)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([placeId, day])
  @@map("place_daily_stats")
}

// What a student can ask for from a table ("Water", "Request bill"). Configured per place.
model TableRequestType {
  id        String       @id @default(uuid(7)) @db.Char(36)
  placeId   String       @db.Char(36)
  label     String       @db.VarChar(40)
  // A key from the app icon set.
  icon      String?      @db.VarChar(40)
  status    ActiveStatus @default(ACTIVE)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  place    Place            @relation(fields: [placeId], references: [id], onDelete: Cascade)
  requests ServiceRequest[]

  @@index([placeId, sortOrder])
  @@map("table_request_types")
}

enum RequestKind {
  // "Water for Table 07": quick, acknowledged and done.
  TABLE
  // A job: repair, laundry pickup. May go through an estimate the student approves.
  GENERAL
}

// One lifecycle for every request kind; each kind allows only its own moves (request-rules.ts).
enum RequestStatus {
  NEW
  ACKNOWLEDGED
  ACCEPTED
  DIAGNOSING
  ESTIMATE_AVAILABLE
  APPROVED
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
  REJECTED
}

// A request from a student to a business: a table request, a repair, a laundry pickup.
model ServiceRequest {
  id                String        @id @default(uuid(7)) @db.Char(36)
  code              String        @unique @db.VarChar(12)
  kind              RequestKind
  placeId           String        @db.Char(36)
  businessProfileId String        @db.Char(36)
  userId            String        @db.Char(36)
  serviceTypeId     String        @db.Char(36)
  tableId           String?       @db.Char(36)
  tableLabel        String?       @db.VarChar(30)
  requestTypeId     String?       @db.Char(36)
  serviceItemId     String?       @db.Char(36)
  // What was asked for, copied: "Water", "Screen replacement".
  label             String        @db.VarChar(100)
  description       String?       @db.Text
  // A private photo of the problem (key in the private store, never a public URL).
  imageKey          String?       @db.VarChar(80)
  preferredAt       DateTime?
  status            RequestStatus @default(NEW)
  // The business's estimate in whole rupees, which the student approves before work starts.
  estimateAmount    Int?
  estimateNote      String?       @db.VarChar(300)
  statusReason      String?       @db.VarChar(255)
  // "<userId>:<tableId>:<requestTypeId>" while a table request is open: tapping "Water" twice
  // does not send two requests. NULL for other kinds and once handled.
  activeKey         String?       @unique @db.VarChar(120)
  idempotencyKey    String        @db.VarChar(64)
  statusChangedAt   DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  place           Place             @relation(fields: [placeId], references: [id], onDelete: Restrict)
  businessProfile BusinessProfile   @relation(fields: [businessProfileId], references: [id], onDelete: Restrict)
  user            User              @relation("ServiceRequestStudent", fields: [userId], references: [id], onDelete: Restrict)
  serviceType     ServiceType       @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  table           PlaceTable?       @relation(fields: [tableId], references: [id], onDelete: SetNull)
  requestType     TableRequestType? @relation(fields: [requestTypeId], references: [id], onDelete: SetNull)
  serviceItem     ServiceItem?      @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([businessProfileId, status, createdAt])
  @@index([placeId, createdAt])
  @@index([userId, createdAt])
  @@map("service_requests")
}

enum OfferDiscountType {
  PERCENT
  FLAT
  // A free item or perk given in person ("free tea with any meal"); no rupee discount.
  FREEBIE
}

enum OfferLimitPeriod {
  ONCE
  DAILY
}

enum OfferStatus {
  ACTIVE
  PAUSED
  EXPIRED
  // Taken down by staff; only staff and the business see it.
  REMOVED
}

// A student offer a business runs: "10% off for CampusPin students".
model StudentOffer {
  id                String            @id @default(uuid(7)) @db.Char(36)
  placeId           String            @db.Char(36)
  businessProfileId String            @db.Char(36)
  title             String            @db.VarChar(80)
  description       String?           @db.VarChar(500)
  discountType      OfferDiscountType
  // Percent (1-100) or whole rupees; 0 for FREEBIE.
  discountValue     Int               @default(0)
  // PERCENT only: the most it can take off, in rupees.
  maxDiscount       Int?
  minOrderAmount    Int?
  validFrom         DateTime          @db.Date
  validUntil        DateTime?         @db.Date
  // Bit 0 = Monday ... bit 6 = Sunday. 127 = every day.
  daysOfWeek        Int               @default(127) @db.TinyInt
  limitPerStudent   Int               @default(1)
  limitPeriod       OfferLimitPeriod  @default(ONCE)
  totalLimit        Int?
  redeemedCount     Int               @default(0)
  terms             String?           @db.Text
  status            OfferStatus       @default(ACTIVE)
  removedReason     String?           @db.VarChar(255)
  createdById       String?           @db.Char(36)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  place           Place             @relation(fields: [placeId], references: [id], onDelete: Cascade)
  businessProfile BusinessProfile   @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  createdBy       User?             @relation("OfferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  redemptions     OfferRedemption[]

  @@index([status, validUntil])
  @@index([placeId])
  @@index([businessProfileId, createdAt])
  @@map("student_offers")
}

enum RedemptionStatus {
  // A code was issued; the student shows it at the counter.
  ISSUED
  REDEEMED
  // Not used in time; the slot can be issued again.
  EXPIRED
}

// One use of an offer by a student. (offerId, userId, periodKey, slot) is unique, so the database
// itself stops a student using an offer more often than allowed, even with simultaneous taps.
model OfferRedemption {
  id                String           @id @default(uuid(7)) @db.Char(36)
  offerId           String           @db.Char(36)
  userId            String           @db.Char(36)
  placeId           String           @db.Char(36)
  businessProfileId String           @db.Char(36)
  code              String           @unique @db.VarChar(12)
  status            RedemptionStatus @default(ISSUED)
  // "ONCE" or the India date (YYYY-MM-DD) for daily offers.
  periodKey         String           @db.VarChar(10)
  slot              Int              @default(1)
  expiresAt         DateTime
  redeemedAt        DateTime?
  verifiedById      String?          @db.Char(36)
  // Set when the offer was applied to an order instead of shown at a counter.
  orderId           String?          @unique @db.Char(36)
  // Rupees taken off (0 for a freebie or a counter redemption).
  discountAmount    Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  offer           StudentOffer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user            User            @relation("RedemptionStudent", fields: [userId], references: [id], onDelete: Cascade)
  place           Place           @relation(fields: [placeId], references: [id], onDelete: Cascade)
  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  verifiedBy      User?           @relation("RedemptionVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  order           ServiceOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([offerId, userId, periodKey, slot])
  @@index([businessProfileId, createdAt])
  @@index([userId, createdAt])
  @@map("offer_redemptions")
}

enum DocumentKind {
  // A PDF sent to a print shop.
  PRINT
  // A photo of a problem for a repair or laundry request.
  REQUEST_PHOTO
}

// A private file a student uploaded for one order or request. The bytes live in PRIVATE_UPLOAD_DIR
// under a random key, never at a public URL; the API streams them only to the student and to the
// business the file was sent to. The file is deleted once the job is finished.
model PrivateDocument {
  id          String       @id @default(uuid(7)) @db.Char(36)
  userId      String       @db.Char(36)
  kind        DocumentKind
  // Key in the private store ("<uuid>.pdf"); null once the file was deleted.
  fileKey     String?      @db.VarChar(80)
  // As the student named it, cleaned for display only (never used as a path).
  fileName    String       @db.VarChar(120)
  contentType String       @db.VarChar(40)
  sizeBytes   Int
  pageCount   Int?
  // Set when attached to an order or request: a document is used once.
  usedAt      DateTime?
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  order ServiceOrder?

  @@index([userId, createdAt])
  @@map("private_documents")
}

// When a bookable service is open, per weekday. Several windows a day are allowed (10-13, 16-20).
// Times are "HH:mm" in India time.
model BookingSchedule {
  id            String   @id @default(uuid(7)) @db.Char(36)
  placeId       String   @db.Char(36)
  serviceTypeId String   @db.Char(36)
  // ISO weekday: 1 = Monday ... 7 = Sunday.
  dayOfWeek     Int      @db.TinyInt
  openTime      String   @db.VarChar(5)
  closeTime     String   @db.VarChar(5)
  createdAt     DateTime @default(now())

  place       Place       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)

  @@unique([placeId, serviceTypeId, dayOfWeek, openTime])
  @@map("booking_schedules")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// A student's booking of one slot of a bookable item (a haircut at 18:30, a study seat for a day).
// While it is live, slotKey ("<item>|<start>|<seat>") is set and UNIQUE, so the same seat can never
// be booked twice even by simultaneous requests; studentKey stops one student booking a slot twice.
model Booking {
  id                String        @id @default(uuid(7)) @db.Char(36)
  code              String        @unique @db.VarChar(12)
  placeId           String        @db.Char(36)
  businessProfileId String        @db.Char(36)
  userId            String        @db.Char(36)
  serviceTypeId     String        @db.Char(36)
  serviceItemId     String?       @db.Char(36)
  // Copied so the booking reads right if the item changes.
  itemName          String        @db.VarChar(100)
  // India date of the slot.
  date              DateTime      @db.Date
  startAt           DateTime
  endAt             DateTime
  seatNo            Int
  // Whole rupees, copied from the item; paid at the place.
  price             Int
  status            BookingStatus @default(PENDING)
  note              String?       @db.VarChar(300)
  statusReason      String?       @db.VarChar(255)
  slotKey           String?       @unique @db.VarChar(100)
  studentKey        String?       @unique @db.VarChar(100)
  idempotencyKey    String        @db.VarChar(64)
  statusChangedAt   DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  place           Place           @relation(fields: [placeId], references: [id], onDelete: Restrict)
  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Restrict)
  user            User            @relation("BookingStudent", fields: [userId], references: [id], onDelete: Restrict)
  serviceType     ServiceType     @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  serviceItem     ServiceItem?    @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([businessProfileId, startAt])
  @@index([serviceItemId, startAt, status])
  @@index([userId, startAt])
  @@index([status, startAt])
  @@map("bookings")
}
