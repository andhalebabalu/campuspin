# =====================================================================
# API environment. Copy this file to `.env` (same folder) and adjust.
#   Windows (PowerShell):  Copy-Item apps/api/.env.example apps/api/.env
#   macOS / Linux / Git Bash:  cp apps/api/.env.example apps/api/.env
# `.env` is git-ignored. NEVER commit real passwords or secrets.
# =====================================================================

# ---- Application ---------------------------------------------------
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# Browser origins allowed to call the API (CORS). Comma-separated, no trailing slash needed.
CORS_ORIGINS=http://localhost:3000

# Set to true only when running behind a reverse proxy / load balancer.
TRUST_PROXY=false

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Swagger UI at /api/docs. Defaults to true outside production; set explicitly to override.
SWAGGER_ENABLED=true

# ---- Database: XAMPP MySQL (MariaDB) -------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# XAMPP's default is user "root" with an EMPTY password (note the colon with nothing after it):
DATABASE_URL="mysql://root:@localhost:3306/link_platform"
#
# If you set a root password in XAMPP, put it after the colon:
#   DATABASE_URL="mysql://root:YourPassword@localhost:3306/link_platform"
# Special characters in the password must be URL-encoded:  @ -> %40   : -> %3A   / -> %2F   # -> %23
#
# The database itself must exist first: run `npm run db:create` (see the README, Step 2), then `npm run db:migrate`.

# ---- Rate limiting -------------------------------------------------
# Max requests per client IP within the window.
THROTTLE_LIMIT=120
THROTTLE_TTL_SECONDS=60

# ---- Authentication (JWT) ------------------------------------------
# Two DIFFERENT secrets sign the two token types. Each must be a random string of 32+ characters
# (48+ recommended). Generate one with:
#     node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
#
# DEVELOPMENT: if you leave these unset, the API falls back to built-in secrets that are PUBLIC (they
# are in the repository) and logs a warning. Fine on a laptop, never anywhere else. Generate your own
# and put them in apps/api/.env; do NOT commit them.
# PRODUCTION: both are REQUIRED, must differ, and must not contain "dev-only" / "change-me"; the API
# refuses to start otherwise. Store them in your host's secret manager, never in git.
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-generate-your-own-48-chars
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret-generate-your-own-48-chars

# Lifetimes: a whole number plus s, m, h or d (900s, 15m, 12h, 30d).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h

# Stricter per-IP limit for login, register, resend-verification, forgot/reset-password and refresh
# (the global THROTTLE_LIMIT above still applies to everything). Raise it freely in development.
AUTH_RATE_LIMIT=20
AUTH_RATE_LIMIT_TTL_SECONDS=60

# ---- Email ---------------------------------------------------------
# console = DEVELOPMENT ONLY: nothing is sent; each email (with its verification / reset link) is
#           printed in the API terminal. The API refuses to start in production with this.
# memory  = automated tests only.
# smtp    = really sends, through the SMTP_* server below. Required in production.
EMAIL_PROVIDER=console
EMAIL_FROM="CampusPin <no-reply@localhost.test>"
APP_NAME=CampusPin

# Only read when EMAIL_PROVIDER=smtp. For Gmail: turn on 2-Step Verification, create an app password
# (Google Account > Security > App passwords) and use it as SMTP_PASS (spaces are fine). Keep
# EMAIL_FROM on the same Gmail address, or Gmail rewrites the sender. Gmail sends ~500 emails a day.
# SMTP_SECURE: true for port 465 (TLS from the start), false for 587 (STARTTLS, enforced).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Uploads ─────────────────────────────────────────────────────────────────────────────────────
# Where uploaded images are stored (relative to apps/api). Served at ${API_BASE_URL}/uploads/.
UPLOAD_DIR=uploads
# Student ID photos (private, never served; must not be inside UPLOAD_DIR). Deleted after review.
PRIVATE_UPLOAD_DIR=private-uploads

# ── Students ────────────────────────────────────────────────────────────────────────────────────
# Days a student verification stays valid, and the default marketplace "nearby colleges" reach.
STUDENT_VERIFICATION_VALID_DAYS=365
MARKETPLACE_NEARBY_KM=10

# Later phases add: Cloudinary / local upload settings (storage). See docs/09-env-and-seed.md.

# ---- Seed (development only) ---------------------------------------
# `npm run db:seed` creates a DEMO super admin so a fresh dev database is usable:
#     admin@localhost.test  /  ChangeMe123!
# Development ONLY. Change or remove this account before any real deployment. The seed refuses to
# create it when NODE_ENV=production. Uncomment to use different values:
# SEED_ADMIN_EMAIL=admin@localhost.test
# SEED_ADMIN_PASSWORD=ChangeMe123!
