# =====================================================================
# Web environment. Copy this file to `.env.local` (same folder) and adjust.
#   Windows (PowerShell):  Copy-Item apps/web/.env.example apps/web/.env.local
#   macOS / Linux / Git Bash:  cp apps/web/.env.example apps/web/.env.local
# `.env.local` is git-ignored.
#
# Anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle and is PUBLIC.
# Never put secrets here, and never DATABASE_URL: the web app never talks to MySQL.
# =====================================================================

# Base URL of the NestJS API, including the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Public URL of this web app (used for canonical URLs and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Working brand name (kept in one place so it can change later).
NEXT_PUBLIC_BRAND_NAME=CampusPin

# Optional: the address businesses can write to from Help & support. Leave empty to hide it.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---- Legal pages (/privacy, /terms, /grievance) ------------------------------------------------
# Indian IT Rules 2021 require the Grievance Officer's name and contact to be published. Until these
# are set, the pages say the details are "to be published" (nothing is made up).
# NEXT_PUBLIC_LEGAL_ENTITY=CampusPin Technologies Pvt. Ltd.   # who runs the service
# NEXT_PUBLIC_LEGAL_ADDRESS=Office address, Pune, Maharashtra 411001
# NEXT_PUBLIC_LEGAL_JURISDICTION=Pune                          # courts named in the Terms
# NEXT_PUBLIC_GRIEVANCE_OFFICER=Full Name
# NEXT_PUBLIC_GRIEVANCE_EMAIL=grievance@example.com
# NEXT_PUBLIC_GRIEVANCE_PHONE=+91 90000 00000                  # optional
