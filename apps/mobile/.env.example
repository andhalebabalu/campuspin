# Copy to `.env` (git-ignored) only when you need to override the defaults.
#
# Where the API is. Leave unset in development: the app uses the computer running `npx expo start`
# (port 3001), which works when the phone and the computer are on the same Wi-Fi.
# Set it when using `npx expo start --tunnel`, or for a deployed API:
# EXPO_PUBLIC_API_URL=https://api.campuspin.in/api/v1

# The public website: review QR codes point here. Defaults to the web app on port 3000 in development.
# EXPO_PUBLIC_SITE_URL=https://campuspin.in

# Android release builds only (Expo Go has its own). Set it as an EAS environment variable, not here.
# GOOGLE_MAPS_API_KEY=
